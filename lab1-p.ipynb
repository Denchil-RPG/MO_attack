    "# Визуализация карты рисков: вероятность x ущерб\n",
    "fig, ax = plt.subplots(figsize=(9, 7))\n",
    "colors = {'Высокая': '#C00000', 'Средне-высокая': '#ED7D31',\n",
    "          'Средняя': '#FFC000', 'Низкая': '#70AD47'}\n",
    "\n",
    "\n",
    "def risk_level(score):\n",
    "    if score >= 15:\n",
    "        return 'Высокая'\n",
    "    if score >= 10:\n",
    "        return 'Средне-высокая'\n",
    "    if score >= 6:\n",
    "        return 'Средняя'\n",
    "    return 'Низкая'\n",
    "\n",
    "\n",
    "for _, r in risk_df.iterrows():\n",
    "    p, d = r['Вероятность (1-5)'], r['Ущерб (1-5)']\n",
    "    lvl = risk_level(r['Итоговая критичность'])\n",
    "    ax.scatter(p, d, s=r['Итоговая критичность'] * 55, c=colors[lvl],\n",
    "               alpha=0.75, edgecolors='black', linewidths=0.8, zorder=3)\n",
    "    ax.annotate(f\"{r['Итоговая критичность']}\", (p, d), ha='center', va='center',\n",
    "                fontsize=8, fontweight='bold', color='white', zorder=4)\n",
    "\n",
    "ax.set_xticks(range(1, 6)); ax.set_yticks(range(1, 6))\n",
    "ax.set_xlabel('Вероятность (1-5)'); ax.set_ylabel('Ущерб (1-5)')\n",
    "ax.set_title('Карта рисков антифрод-системы (размер и цвет = критичность)')\n",
    "ax.grid(True, alpha=0.3)\n",
    "legend_handles = [mpatches.Patch(color=c, label=l) for l, c in colors.items()]\n",
    "ax.legend(handles=legend_handles, loc='lower left', title='Уровень критичности')\n",
    "# зоны критичности\n",
    "ax.axhspan(4.5, 5.5, xmin=0.6, color='#C00000', alpha=0.06)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
